# Server 1
PAPERLESS_SERVER_NAME=server1
PAPERLESS_SERVER_URL=http://localhost:8000 #tailscale based routing is reccommended to avoid browser blocks.
PAPERLESS_SERVER_TOKEN=your-token-here

# Server 2 (optional)
# PAPERLESS_SERVER_2_NAME=server2
# PAPERLESS_SERVER_2_URL=http://localhost:8001
# PAPERLESS_SERVER_2_TOKEN=your-token-here

# Add more servers as needed:
# PAPERLESS_SERVER_3_NAME=server3
# PAPERLESS_SERVER_3_URL=http://localhost:8002
# PAPERLESS_SERVER_3_TOKEN=your-token-here

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_FALLBACK_MODEL=qwen3.5:latest
DOCUMENT_TITLE_LANGUAGE=Estonian
# Optional: fully override the built-in title guidance prompt
# OLLAMA_TITLE_PROMPT_HINT=Always generate concise document titles in English.

# Processing
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=240
